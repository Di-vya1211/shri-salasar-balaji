/* ===== BRAND SYSTEM (from style guide) ===== */
:root {
    /* Colors */
    --color-primary: #1D9AD6;      /* Mineral Blue */
    --color-dark: #1F1F1F;         /* Deep Charcoal */
    --color-white: #FFFFFF;
    --color-sky: #EAF7FD;          /* Light Sky Blue */
    --color-steel: #707070;        /* Steel Grey */
    --color-soft-grey: #F5F7F8;
    --color-silver: #D9D9D9;
    --color-success: #22C55E;
    --color-warning: #F59E0B;
    --color-error: #DC2626;

    /* Typography */
    --font-heading: 'Poppins', sans-serif;
    --font-body: 'Inter', sans-serif;

    /* Radius */
    --radius-card: 16px;
    --radius-button: 10px;
    --radius-input: 8px;
    --radius-image: 12px;

    /* Shadows */
    --shadow-card: 0 8px 24px rgba(0, 0, 0, 0.08);
    --shadow-hover: 0 12px 30px rgba(0, 0, 0, 0.12);
}

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background-color: var(--color-soft-grey);
    color: var(--color-dark);
}

* {
    box-sizing: border-box;
}

img {
    max-width: 100%;
    height: auto;
}

/* ===== TYPOGRAPHY SCALE (from style guide) ===== */
h1, .hero h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.35;
    color: var(--color-dark);
}

h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(26px, 3.3vw, 40px);
    line-height: 1.3;
    color: var(--color-dark);
}

h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(20px, 2vw, 32px);
    line-height: 1.3;
    color: var(--color-dark);
}

h4 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(18px, 1.6vw, 28px);
    line-height: 1.4;
    color: var(--color-dark);
}

h5 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(16px, 1.4vw, 24px);
    line-height: 1.4;
    color: var(--color-dark);
}

h6 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(14px, 1.2vw, 20px);
    line-height: 1.4;
    color: var(--color-dark);
}

p {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-dark);
}

.text-large {
    font-size: 18px;
}

.text-small {
    font-size: 14px;
}

.text-caption {
    font-size: 12px;
    color: var(--color-steel);
}

/* ===== HERO SECTION ===== */
/* ===== HERO SECTION — grid based, guaranteed equal height ===== */
.hero {
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 80px;
    background-color: #F8FAFC;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    gap: 40px;
    position: relative;   /* naya — ensures nothing inside can escape via absolute positioning */
}

.hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    min-width: 0;
    position: relative;
    z-index: 2;
}

.hero-img-wrapper {
    position: relative !important;   
    top: auto !important;
    right: auto !important;
    bottom: auto !important;
    overflow: hidden;
    border-radius: var(--radius-card);
    min-height: 100%;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);   
    border: 1px solid rgba(0, 0, 0, 0.06);       
}

.hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.hero-img-wrapper:hover .hero-img {
    transform: scale(1.05);
}

.hero h1 {
    letter-spacing: 0.2%;
}

.hero p {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.3vw, 18px);
    color: var(--color-steel);
    max-width: 560px;
    line-height: 1.6;
}

.hero-buttons {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
}

.btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    height: 46px;
    background-color: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-button);
    padding: 0 24px;
    color: white !important;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    text-decoration: none !important;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
}

.btn-primary:hover {
    background-color: #157fb8;
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
}

.btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    height: 46px;
    white-space: nowrap;
    background-color: white;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-button);
    padding: 0 20px;
    text-decoration: none !important;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    color: var(--color-primary) !important;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease;
}

.btn-secondary:hover {
    background-color: var(--color-sky);
    transform: translateY(-2px);
}

.hero-stats {
    display: flex;
    gap: 0;
    margin-top: 10px;
    flex-wrap: wrap;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 24px;
    position: relative;
}

.stat-item:first-child {
    padding-left: 0;
}

.stat-item:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 36px;
    background-color: var(--color-silver);
}

.stat-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
}

.stat-item h3 {
    font-weight: 500;
    font-size: clamp(16px, 1.4vw, 22px);
    color: var(--color-dark);
    margin: 0;
}

.stat-item p {
    font-family: var(--font-body);
    font-size: clamp(12px, 1vw, 14px);
    color: var(--color-steel);
    margin: 0;
    white-space: nowrap;
}

