.hero-social {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-self: center;
}

.hero-social a {
    color: var(--color-dark);
    display: flex;
    transition: color 0.2s ease, transform 0.2s ease;
}

.hero-social a:hover {
    color: var(--color-primary);
    transform: scale(1.15);
}

.hero-social svg {
    width: 20px;
    height: 20px;
}

/* ===== WHY CHOOSE US ===== */
.why-choose-us {
    padding: 80px 40px;
    max-width: 1440px;
    margin: 0 auto;
    text-align: center;
}

.why-choose-us .intro {
    text-align: left;
    max-width: 100%;
    margin-bottom: 48px;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
    text-align: left;
}

.feature-box {
    background-color: var(--color-sky);
    padding: 32px;
    border-radius: var(--radius-card);
    border: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
}

.feature-box:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
}

.feature-box-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
}

.feature-icon {
    width: 40px;
    height: 40px;
    stroke: var(--color-dark);
    flex-shrink: 0;
    transition: transform 0.3s ease;
}

.feature-box:hover .feature-icon {
    transform: scale(1.1) rotate(-4deg);
}

.feature-box p {
    font-size: 15px;
    color: var(--color-dark);
    line-height: 1.6;
    margin: 0;
}

/* ===== OUR PRODUCTS ===== */
.our-products {
    padding: 60px 40px;
    text-align: center;
    max-width: 1440px;
    margin: 0 auto;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    max-width: 1300px;
    margin: 0 auto;
}

.product-card {
    background-color: var(--color-sky);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-align: left;
    padding: 16px;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
}

.product-card .img-wrap {
    overflow: hidden;
    border-radius: var(--radius-image);
    margin-bottom: 12px;
}

.product-card img {
    border-radius: var(--radius-image);
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
}

.product-card:hover img {
    transform: scale(1.08);
}

.product-info h3 {
    margin-bottom: 8px;
}

.product-info p {
    font-size: clamp(13px, 1vw, 16px);
    line-height: 1.4;
    margin-bottom: 4px;
}

.product-info .btn-outline {
    margin-top: 20px;
    align-self: center;
}

.see-all {
    margin-top: 40px;
}

/* ===== ABOUT US (short) — clean single image, no stacking ===== */
.about-short {
    padding: 60px 40px;
    max-width: 1440px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(to right, var(--color-sky), #FFFFFF);
}

.about-content {
    display: flex;
    flex-direction: row;
    gap: 40px;
    align-items: center;
    text-align: left;
    max-width: 1360px;
    margin: 0 auto;
    flex-wrap: wrap;
}

.about-text {
    flex: 1 1 320px;
    min-width: 0;
    max-width: 679px;
    display: flex;
    flex-direction: column;
}

.about-text p {
    line-height: 1.6;
    font-size: clamp(14px, 1.2vw, 18px);
    margin-bottom: 16px;
}

/* Force a single clean image — kills any leftover rotated/stacked pseudo-elements */
.about-content .img-wrap,
.about-content > img {
    flex: 1 1 280px;
    max-width: 500px;
    width: 100%;
    min-width: 250px;
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 612 / 556;
    position: relative;
    transform: none !important;
    box-shadow: var(--shadow-card);
}

.about-content .img-wrap::before,
.about-content .img-wrap::after,
.about-content > img::before,
.about-content > img::after {
    content: none !important;
    display: none !important;
}

.about-content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-image);
    transition: transform 0.4s ease;
    transform: none;
}

.about-content .img-wrap:hover img {
    transform: scale(1.06);
}

.btn-outline {
    display: inline-block;
    margin-top: 16px;
    align-self: flex-start;
    padding: 10px 24px;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-button);
    color: var(--color-primary);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 14px;
    width: fit-content;
    background-color: white;
    transition: background-color 0.25s ease, transform 0.2s ease;
}

.btn-outline:hover {
    background-color: var(--color-sky);
    transform: translateY(-2px);
}

/* ===== FAQ ===== */
.faq {
    padding: 60px 40px;
    max-width: 1280px;
    margin: 0 auto;
}

.faq-item {
    border: 1px solid var(--color-silver);
    border-radius: var(--radius-card);
    margin-bottom: 16px;
    overflow: hidden;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
}

.faq-item:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card);
}

.faq-question {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 20px 24px;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.2vw, 18px);
    color: var(--color-dark);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 500;
    gap: 16px;
}

.faq-question:hover {
    background-color: var(--color-soft-grey);
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    padding: 0 24px;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-size: clamp(13px, 1vw, 15px);
    color: var(--color-steel);
    line-height: 1.6;
}

.faq-answer.open {
    max-height: 500px;
    padding: 0 24px 20px;
}

/* ===== CONTACT US ===== */
.contact-us {
    padding: 60px 40px;
    max-width: 1280px;
    margin: 0 auto;
}

.contact-wrapper {
    display: flex;
    flex-wrap: wrap;
    max-width: 1280px;
    margin: 0 auto;
    border: 1px solid var(--color-silver);
    border-radius: var(--radius-card);
    overflow: hidden;
}

.contact-form {
    flex: 1 1 320px;
    padding: 30px;
    border-right: 1px solid var(--color-silver);
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.contact-accordion {
    flex: 1 1 320px;
    padding: 30px;
    overflow-y: auto;
    min-width: 0;
}

.contact-form label {
    font-size: 13px;
    color: var(--color-dark);
    margin-top: 14px;
    display: block;
    font-weight: 500;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    margin-top: 6px;
    padding: 10px 12px;
    border: 1px solid var(--color-silver);
    border-radius: var(--radius-input);
    font-family: var(--font-body);
    font-size: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.contact-form input:focus,
.contact-form textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(29, 154, 214, 0.15);
}

.contact-form textarea {
    min-height: 100px;
    resize: vertical;
}

.phone-input {
    display: flex;
    gap: 8px;
    margin-top: 6px;
}

.country-code {
    padding: 10px 8px;
    border: 1px solid var(--color-silver);
    border-radius: var(--radius-input);
    background-color: white;
    min-width: 70px;
}

.phone-input input {
    margin-top: 0;
    flex: 1;
    min-width: 0;
}

.contact-form button {
    margin-top: 20px;
    background-color: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-weight: 500;
    cursor: pointer;
    width: 200px;
    max-width: 100%;
    height: 46px;
    align-self: flex-start;
    transition: background-color 0.25s ease, transform 0.2s ease;
}

.contact-form button:hover {
    background-color: #157fb8;
    transform: translateY(-2px);
}

.acc-item {
    width: 100%;
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-silver);
    text-align: left;
    padding: 14px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-dark);
    cursor: pointer;
    transition: color 0.2s ease;
}

.acc-item:hover {
    color: var(--color-primary);
}

.acc-answer {
    max-height: 0;
    overflow: hidden;
    padding: 0 4px;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-size: 13px;
    color: var(--color-steel);
    line-height: 1.7;
}

.acc-answer.open {
    max-height: 500px;
    padding: 8px 4px 16px;
}

.contact-note {
    font-size: 12px;
    color: var(--color-steel);
    margin-top: 16px;
    line-height: 1.5;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
    .features-grid,
    .product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .hero {
        padding: 50px 40px;
    }
}

@media (max-width: 768px) {
    .hero {
        padding: 40px 24px;
        flex-direction: column;
    }

    .hero-content {
        max-width: 100%;
    }

    .hero-img-wrapper {
        width: 100%;
        min-height: 220px;
        order: 2;
    }

    .hero-buttons {
        flex-direction: column;
        gap: 12px;
    }

    .btn-primary,
    .btn-secondary {
        width: 100%;
        min-width: unset;
    }

    .hero-stats {
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
    }

    .stat-item {
        padding: 8px 0;
    }

    .stat-item:not(:last-child)::after {
        display: none;
    }

    .hero-social {
        display: none;
    }

    .why-choose-us,
    .our-products,
    .about-short,
    .faq,
    .contact-us {
        padding: 40px 20px;
    }

    .features-grid,
    .product-grid {
        grid-template-columns: 1fr;
    }

    .product-card img {
        height: 220px;
    }

    .about-content {
        flex-direction: column;
    }

    .contact-wrapper {
        flex-direction: column;
    }

    .contact-form {
        border-right: none;
        border-bottom: 1px solid var(--color-silver);
        padding: 20px;
    }

    .contact-accordion {
        padding: 20px;
    }

    .contact-form button {
        width: 100%;
    }

    .feature-box:hover,
    .product-card:hover,
    .btn-primary:hover,
    .btn-secondary:hover,
    .btn-outline:hover,
    .contact-form button:hover {
        transform: none;
    }
}

@media (max-width: 480px) {
    .hero,
    .why-choose-us,
    .our-products,
    .about-short,
    .faq,
    .contact-us {
        padding: 30px 16px;
    }

    .feature-box {
        padding: 20px 16px;
    }

    .product-card img {
        height: 180px;
    }
}

@media (prefers-reduced-motion: reduce) {
    * {
        transition: none !important;
        animation: none !important;
    }
}